rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === LEADERBOARDS ===
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /danmaku_leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /blockblast_leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // === USER PROFILES ===
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // === COMMUNITY FEEDBACK (Unified) ===
    match /feedback/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /votes/{voteKey} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == voteKey;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;
      }
    }

    // Compatibility for legacy feedback_hub
    match /feedback_hub/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /votes/{voteKey} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == voteKey;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;
      }
    }
  }
}
