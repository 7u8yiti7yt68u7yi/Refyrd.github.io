rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard (Snake)
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'score'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Leaderboard (Danmaku Hell)
    match /danmaku_leaderboard/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'score'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Users profile & nickname cooldown
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'nicknameLastChange'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 30;
    }

    // Feedback entries (Snake)
    match /feedback/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message', 'name', 'time', 'likes', 'dislikes', 'commentCount', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'dislikes', 'commentCount']);
      allow delete: if request.auth != null
        && (
          !resource.data.keys().hasAny(['uid'])
          || resource.data.uid == request.auth.uid
        );

      // Votes subcollection
      match /votes/{voteKey} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == voteKey;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'message', 'uid', 'time'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 50;
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['message'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500;
        allow delete: if request.auth != null
          && (
            !resource.data.keys().hasAny(['uid'])
            || resource.data.uid == request.auth.uid
          );
      }
    }

    // Feedback entries (Hub)
    match /feedback_hub/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message', 'name', 'time', 'likes', 'dislikes', 'commentCount', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'dislikes', 'commentCount']);
      allow delete: if request.auth != null
        && (
          !resource.data.keys().hasAny(['uid'])
          || resource.data.uid == request.auth.uid
        );

      // Votes subcollection
      match /votes/{voteKey} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == voteKey;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'message', 'uid', 'time'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 50;
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['message'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500;
        allow delete: if request.auth != null
          && (
            !resource.data.keys().hasAny(['uid'])
            || resource.data.uid == request.auth.uid
          );
      }
    }

    // Feedback entries (Danmaku Hell)
    match /danmaku_feedback/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message', 'name', 'time', 'likes', 'dislikes', 'commentCount', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'dislikes', 'commentCount']);
      allow delete: if request.auth != null
        && (
          !resource.data.keys().hasAny(['uid'])
          || resource.data.uid == request.auth.uid
        );

      // Votes subcollection
      match /votes/{voteKey} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == voteKey;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'message', 'uid', 'time'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 50;
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['message'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500;
        allow delete: if request.auth != null
          && (
            !resource.data.keys().hasAny(['uid'])
            || resource.data.uid == request.auth.uid
          );
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
