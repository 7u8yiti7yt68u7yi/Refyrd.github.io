rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Users profile & nickname cooldown
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Feedback entries (Snake)
    match /feedback/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message', 'name', 'time', 'likes', 'dislikes', 'commentCount', 'uid']);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'dislikes', 'commentCount']);
      allow delete: if request.auth != null
        && (
          !resource.data.keys().hasAny(['uid'])
          || resource.data.uid == request.auth.uid
        );

      // Votes subcollection
      match /votes/{voteKey} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == voteKey
          && request.resource.data.keys().hasOnly(['type', 'userId', 'feedbackId', 'timestamp']);
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'message', 'uid', 'time']);
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['message']);
        allow delete: if request.auth != null
          && (
            !resource.data.keys().hasAny(['uid'])
            || resource.data.uid == request.auth.uid
          );
      }
    }

    // Feedback entries (Hub)
    match /feedback_hub/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message', 'name', 'time', 'likes', 'dislikes', 'commentCount', 'uid']);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'dislikes', 'commentCount']);
      allow delete: if request.auth != null
        && (
          !resource.data.keys().hasAny(['uid'])
          || resource.data.uid == request.auth.uid
        );

      // Votes subcollection
      match /votes/{voteKey} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == voteKey;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'message', 'uid', 'time']);
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['message']);
        allow delete: if request.auth != null
          && (
            !resource.data.keys().hasAny(['uid'])
            || resource.data.uid == request.auth.uid
          );
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
